grammar SQL;
options { caseInsensitive = true; }
script: (statement (';' statement)* ';'?)? EOF;
statement: createTable | dropTable | createIndex | dropIndex | insertStmt | updateStmt | deleteStmt | selectStmt;
createTable: CREATE TABLE ID '(' columnDef (',' columnDef)* ')';
columnDef: ID dataType constraint*;
dataType: INT | FLOAT | VARCHAR '(' INTEGER ')' | BOOLEAN | DATE;
constraint: NOT NULL | UNIQUE | PRIMARY KEY;
dropTable: DROP TABLE ID;
createIndex: CREATE INDEX ID ON ID '(' ID ')';
dropIndex: DROP INDEX ID;
insertStmt: INSERT INTO ID ('(' ID (',' ID)* ')')? VALUES valueRow (',' valueRow)*;
valueRow: '(' expr (',' expr)* ')';
updateStmt: UPDATE ID SET assignment (',' assignment)* (WHERE expr)?;
assignment: ID '=' expr;
deleteStmt: DELETE FROM ID (WHERE expr)?;
selectStmt: SELECT selectItem (',' selectItem)* FROM tableRef joinClause* (WHERE expr)? (GROUP BY expr (',' expr)*)? (HAVING expr)? (ORDER BY orderItem (',' orderItem)*)?;
selectItem: '*' | ID '.' '*' | expr (AS? ID)?;
tableRef: ID (AS? ID)?;
joinClause: INNER JOIN tableRef ON expr;
orderItem: expr (ASC | DESC)?;
expr: orExpr;
orExpr: andExpr (OR andExpr)*;
andExpr: notExpr (AND notExpr)*;
notExpr: NOT notExpr | predicate;
predicate: additive (comparison additive | NOT? IN '(' selectStmt ')' | IS NOT? NULL)? | EXISTS '(' selectStmt ')';
comparison: '=' | '<>' | '!=' | '<' | '<=' | '>' | '>=';
additive: multiplicative (('+' | '-') multiplicative)*;
multiplicative: unary (('*' | '/') unary)*;
unary: ('+' | '-') unary | primary;
primary: literal | columnRef | aggregate | '(' expr ')' | '(' selectStmt ')';
columnRef: ID ('.' ID)?;
aggregate: (COUNT | SUM | AVG | MIN | MAX) '(' ('*' | expr) ')';
literal: INTEGER | DECIMAL | STRING | TRUE | FALSE | NULL | DATE STRING;
CREATE:'CREATE'; TABLE:'TABLE'; DROP:'DROP'; INDEX:'INDEX'; ON:'ON';
INT:'INT'; FLOAT:'FLOAT'; VARCHAR:'VARCHAR'; BOOLEAN:'BOOLEAN'; DATE:'DATE';
NOT:'NOT'; NULL:'NULL'; UNIQUE:'UNIQUE'; PRIMARY:'PRIMARY'; KEY:'KEY';
INSERT:'INSERT'; INTO:'INTO'; VALUES:'VALUES'; UPDATE:'UPDATE'; SET:'SET'; DELETE:'DELETE';
SELECT:'SELECT'; FROM:'FROM'; WHERE:'WHERE'; AND:'AND'; OR:'OR'; ORDER:'ORDER'; BY:'BY';
INNER:'INNER'; JOIN:'JOIN'; GROUP:'GROUP'; HAVING:'HAVING'; IN:'IN'; EXISTS:'EXISTS';
COUNT:'COUNT'; SUM:'SUM'; AVG:'AVG'; MIN:'MIN'; MAX:'MAX'; AS:'AS'; ASC:'ASC'; DESC:'DESC';
TRUE:'TRUE'; FALSE:'FALSE'; IS:'IS';
DECIMAL: [0-9]+ '.' [0-9]+ ([e] [+-]? [0-9]+)? | [0-9]+ [e] [+-]? [0-9]+;
INTEGER:[0-9]+;
STRING:'\'' ('\'\'' | ~['\r\n])* '\'';
ID:[a-z_] [a-z_0-9]*;
LINE_COMMENT:'--' ~[\r\n]* -> skip;
BLOCK_COMMENT:'/*' .*? '*/' -> skip;
WS:[ \t\r\n]+ -> skip;
